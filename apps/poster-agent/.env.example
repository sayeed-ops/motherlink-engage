# Copy to .env (chmod 600 .env), then edit. .env is gitignored.

# Engage Admin SDK key. The agent writes jobs/drafts/accounts (bypassing rules),
# so it needs the Engage admin key — NOT ML Studio's. Point at your local key,
# or drop a service-account.json next to index.mjs and use ./service-account.json
SERVICE_ACCOUNT_PATH=/Users/you/.config/motherlink-engage/admin.json

# AdsPower Local API (Settings → Local API; default port 50325).
# 127.0.0.1 and local.adspower.net are equivalent; the IP skips a DNS lookup.
ADSPOWER_API=http://127.0.0.1:50325

# REQUIRED. AdsPower added auth to the Local API — without this every call
# answers {"code":-1,"msg":"Require api-key"} and the agent fails the first job
# at "open profile". Copy it from AdsPower → Settings → Local API.
# Sent as an Authorization: Bearer header. Never commit this.
ADSPOWER_API_KEY=

# How often to poll the queue.
POLL_INTERVAL_MS=5000

# How often the heartbeat is written WHILE a job is running (capped at 10000).
# A humanized job takes minutes and the loop blocks for all of it, so the beat
# runs on its own timer — otherwise the web UI's 20s freshness window would call
# a perfectly healthy agent "offline" mid-post. Leave this alone unless you also
# change ONLINE_WINDOW_MS in apps/web/src/lib/agentStatus.ts.
HEARTBEAT_MS=5000

# DEFAULT dry-run only. Dry run opens the profile, verifies the account + thread,
# types the reply, then STOPS (does not submit). This value is just the default
# the agent seeds on first run — after that the LIVE switch is the "Dry run"
# toggle on the Accounts page (stored in Firestore, re-read every poll), so you
# flip it from the web UI with no restart. START WITH 1.
#
# ⚠️ ONLY DRY_RUN=0 MEANS LIVE. Anything else — including leaving the line out —
# means dry run. (It used to be the other way round.) And if the agent ever
# cannot READ the live switch, it treats every platform as dry run and claims
# nothing until it can: not knowing is not permission.
DRY_RUN=1

# How many jobs may run AT THE SAME TIME. Each is a whole AdsPower browser, so
# this machine's memory is the ceiling. 1 is exactly the old one-at-a-time
# behaviour. Whatever you set, two jobs never run together when they share an
# ACCOUNT, an AdsPower PROFILE, or an exit IP (read from AdsPower's own proxy
# settings) — those are locks, taken with the claim. Start at 2, in dry run.
MAX_CONCURRENT=1

# Each running job writes a heartbeat onto its job document this often (ms)…
JOB_HEARTBEAT_MS=20000
# …and a job silent for this long belongs to a dead process: its locks are freed
# and it is marked failed (never re-queued). Default 3 minutes.
HEARTBEAT_STALE_MS=180000

# This machine's name in claims and logs. Defaults to the hostname. Profiles with
# NO proxy share this machine's own IP, so they lock each other.
# AGENT_ID=posting-mac-1

# Reclaim window for jobs claimed by an OLDER agent, which wrote no heartbeat —
# marked failed so you can check Reddit and Post again. Jobs from this version
# are judged by their heartbeat instead (HEARTBEAT_STALE_MS). Default 20 minutes.
STALE_POSTING_MS=1200000

# Close the AdsPower profile after each job (0 = leave it open).
CLOSE_AFTER=0

# Posting surface: old (old.reddit, proven) or new (new reddit / Shreddit).
# DEFAULT only — the live switch is agents/control.postSurface, re-read every poll
# (flip without a restart, instant rollback to old if new misbehaves). Keep this
# 'old' until the new-reddit path is validated live. See docs/NEW-REDDIT-PLAN.md.
POST_SURFACE=old

# Per-step timeout for the new-reddit plan executor (ms). A wedged interaction
# fails the job instead of hanging. Default 150s (covers a full typed fallback of
# a long comment; paste is near-instant when it works).
STEP_TIMEOUT_MS=150000

# How long the bot hesitates before its next action — between plan steps, between
# scroll bursts, before clicking a post it spotted. The draw is SKEWED toward
# short (55% under 15% of max, 15% up to the full max), so raising this stretches
# the occasional long pause rather than slowing everything down. Default 13.
HUMAN_PAUSE_MAX_SEC=13

